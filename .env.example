# ---------------------------------------------------------------------------
# Freshroots Demand Planning — environment variables
# Copy to .env (local) and to Vercel → Project → Settings → Environment Variables.
# Every integration runs in MOCK mode when its variables are empty, so the app
# works end-to-end locally with this file left blank.
# ---------------------------------------------------------------------------

# Postgres connection string. Vercel → Project → Storage → add Neon (or Supabase);
# it fills this in. Empty → an embedded local Postgres (PGlite) in ./.data/pglite.
DATABASE_URL=

# Google AI Studio (aistudio.google.com → Get API key). Empty → template-based reasons.
GEMINI_API_KEY=
# Any current Gemini Flash model name, e.g. gemini-2.5-flash
GEMINI_MODEL=

# Zoho Inventory, India data centre. See docs/ZOHO_SETUP.md.
# Client ID/secret: api-console.zoho.in → Self Client.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Produced once by scripts/zoho-get-refresh-token.ts from a grant code.
ZOHO_REFRESH_TOKEN=
# Zoho Inventory → Settings → Organization Profile.
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in/inventory/v1
# Purchases → Vendors → open the vendor → ID in the URL. Used when a SKU has no vendor.
ZOHO_DEFAULT_VENDOR_ID=

# resend.com → API Keys. Empty → emails are logged to the console and the mock_emails table.
RESEND_API_KEY=
# Sender, e.g. "Freshroots Planner <planner@yourdomain.com>" (Resend test sender: onboarding@resend.dev)
EMAIL_FROM=
PROCUREMENT_EMAIL=
PLANNER_EMAIL=
# Deepa (COO) — receives the red kill-switch alert.
VIEWER_EMAIL=

# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Shared dashboard passwords. Planner (Raghav) can decide/edit rules; viewer (Deepa/CEO) is read-only.
# Empty → local dev runs without a login, as planner.
DASHBOARD_PASSWORD=
VIEWER_PASSWORD=
