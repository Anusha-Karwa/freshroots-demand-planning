# ---------------------------------------------------------------------------------------------
# Freshroots Demand Planning — environment variables
# Copy to .env for local use, and add the same names in Vercel → Project → Settings →
# Environment Variables (or in the Claude Code cloud environment's settings).
# Every integration runs in MOCK mode while its variables are empty, so the app works end-to-end
# with this file left blank. Never commit a real .env.
# ---------------------------------------------------------------------------------------------

# --- Database (Neon Postgres) ---
# Vercel → Project → Storage → Neon → it fills these in. Pooled connection string, ends ?sslmode=require.
# Empty → embedded local Postgres (PGlite) in ./.data/pglite. Required on Vercel.
DATABASE_URL=
# Neon's direct (non-pooled) URL. Used only to apply migrations under a lock. Set by the Neon integration.
DATABASE_URL_UNPOOLED=

# --- Gemini (aistudio.google.com → Get API key) ---
# Empty → template reasons built from the rule numbers.
GEMINI_API_KEY=
# Optional. Default "gemini-flash-latest". Any current Gemini Flash model works.
GEMINI_MODEL=

# --- Zoho Inventory, India data centre (see docs/ZOHO_SETUP.md) ---
# api-console.zoho.in → Add Client → Self Client → Client ID / Client Secret
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Made once with: npm run zoho:refresh-token -- <grant code>
ZOHO_REFRESH_TOKEN=
# Zoho Inventory → Settings → Organization Profile → Organization ID
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in/inventory/v1
# Purchases → Vendors → open the vendor → the id in the URL. Used for suppliers not mapped on the PO page.
ZOHO_DEFAULT_VENDOR_ID=

# --- Resend email (resend.com → API Keys) ---
# Empty → emails are printed to the console and saved in the mock_emails table.
RESEND_API_KEY=
# Sender. Without a verified domain use Resend's test sender: Freshroots Planner <onboarding@resend.dev>
# (the test sender only delivers to the email address of your Resend account).
EMAIL_FROM=
# Raghav — "N items awaiting your call" after each run
PLANNER_EMAIL=
# Procurement — "draft POs ready to confirm in Zoho"
PROCUREMENT_EMAIL=
# Deepa (Head of Operations) — kill switch turned red
VIEWER_EMAIL=
# Public URL used in email links, e.g. https://freshroots-demand-planning.vercel.app (defaults to the Vercel URL)
APP_BASE_URL=

# --- Security ---
# Long random string. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
CRON_SECRET=
# Dashboard passwords. Planner (Raghav) decides and edits rules; viewer (Deepa / CEO) is read-only.
# Empty DASHBOARD_PASSWORD → local dev runs without a login, as the planner.
DASHBOARD_PASSWORD=
VIEWER_PASSWORD=
# Signs the login cookie. Any long random string (falls back to CRON_SECRET).
AUTH_SECRET=
